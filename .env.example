# Required for AI classification
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Safety
CONFIDENCE_THRESHOLD=0.80
TRASH_QUARANTINE_DAYS=14
HISTORICAL_QUARANTINE_DAYS=14
CLEANUP_LIVE=true

# Current inbox
MAX_EMAILS=250
MAX_NEW_EMAILS_PER_RUN=50
MAX_BODY_CHARACTERS=8000

# Historical sender analysis
SENDER_POLICY_MAX_PER_RUN=100
SENDER_POLICY_SAMPLE_SIZE=12
SENDER_POLICY_CONFIDENCE_THRESHOLD=0.90
SENDER_POLICY_OPENAI_DELAY_SECONDS=0.75

# Historical processing
HISTORICAL_BATCH_SIZE=1000
HISTORICAL_PER_SENDER_LIMIT=100
PHASE3_BATCH_SIZE=250
PHASE3_OPENAI_DELAY_SECONDS=0.75
PHASE3_LEARN_MIN_EXAMPLES=3
PHASE3_LEARN_MIN_CONFIDENCE=0.90

# Autonomous worker
AUTO_BACKLOG_REFRESH_HOURS=24
AUTO_INBOX_BATCH_SIZE=50
AUTO_SENDER_POLICY_BATCH_SIZE=30
AUTO_HISTORICAL_BULK_BATCH_SIZE=1000
AUTO_PHASE3_BATCH_SIZE=250
AUTO_IDLE_SECONDS=300
AUTO_ACTIVE_PAUSE_SECONDS=5
AUTO_CLEANUP_EVERY_CYCLES=12
AUTO_DASHBOARD_EVERY_CYCLES=12
AUTO_SENDER_POLICY_ENABLED=true
AUTO_HISTORICAL_ENABLED=true
AUTO_PHASE3_ENABLED=true
